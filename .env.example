# Maps & Geocoding Provider Settings
MAPS_PROVIDER=leaflet
MAPS_API_KEY=

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional local PostgreSQL URL. On Vercel, configure this with a persistent database.
DATABASE_URL=

# Vercel must use a stable secret key so signed demo sessions survive function changes.
